        "With a {adj} heart, I {verb} toward the {rhyme}."
    ]
}


def choose_theme():
    """Return a random theme from the available list."""
    return random.choice(list(word_bank.keys()))


def choose_rhyme(theme):
    """Pick one rhyme family for the poem."""
    if theme in rhyme_families:
        return random.choice(rhyme_families[theme])
    return "light"


def generate_line(theme=None, rhyme_word=None):
    """Generate a single line of poetry with a rhyme ending."""
    selected_theme = theme if theme in word_bank else choose_theme()
    words = word_bank[selected_theme]
    template = random.choice(poem_templates[selected_theme])

    if rhyme_word is None:
        rhyme_word = choose_rhyme(selected_theme)

    return template.format(
        noun=random.choice(words["nouns"]),
        verb=random.choice(words["verbs"]),
        adj=random.choice(words["adjectives"]),
        adv=random.choice(words["adverbs"]),
        rhyme=rhyme_word
    )


def generate_poem(lines=6, theme=None):
    """Generate a poem with a shared rhyme family."""
    selected_theme = theme if theme in word_bank else choose_theme()
    rhyme_family = rhyme_families.get(selected_theme, ["light"])
    poem = [f"[{selected_theme.title()} Theme]"]

    for _ in range(lines):
        rhyme_word = random.choice(rhyme_family)
        poem.append(generate_line(selected_theme, rhyme_word))

    return "\n".join(poem)


def main():
    """Run the poetry generator in the console."""
    print("=== Advanced Poetry Generator ===\n")

    while True:
        theme = input("Choose a theme (nature/love/sadness/hope) or press Enter for random: ").strip().lower()
        if theme == "":
            poem = generate_poem(6)
        elif theme in word_bank:
            poem = generate_poem(6, theme)
        else:
            print("Invalid theme. Try: nature, love, sadness, hope")
            continue

        print("\n" + poem)
        print("\n---------------------")

        choice = input("Generate another poem? (y/n): ").strip().lower()
        if choice != "y":
            print("Goodbye!")
            break


if __name__ == "__main__":
    main()


