# Rhyme families
rhyme_families = {
    "nature": ["light", "bright", "night", "flight", "sight", "glow", "show", "flow", "stream", "dream", "gleam", "beam"],
    "love": ["fire", "desire", "higher", "wire", "glow", "show", "slow", "rose", "close", "home", "roam", "dream"],
    "sadness": ["stone", "alone", "grown", "known", "rain", "pain", "chain", "strain", "tears", "years", "slow", "snow"],
    "hope": ["light", "bright", "flight", "sight", "dawn", "drawn", "glow", "show", "grow", "flow", "home", "roam"]
}

# templates using a rhyme word at the end.
poem_templates = {
    "nature": [
        "The {adj} {noun} {verb} beneath the {rhyme}.",
        "A {adj} breeze {verb} softly through the {rhyme}.",
